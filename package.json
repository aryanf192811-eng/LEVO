{
  "name": "levo-transitops",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "setup:server": "cd server && npm install && npx prisma migrate dev --name init && npx prisma db seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
